{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/web/admin.html" },
    { "source": "/xoailac", "destination": "/web/xoailac/index.html" },
    { "source": "/xoailac/:match*", "destination": "/web/xoailac/:match*" },
    { "source": "/quanlau", "destination": "/web/quanlau/index.html" },
    { "source": "/quanlau/:match*", "destination": "/web/quanlau/:match*" },
    { "source": "/quanlyidol", "destination": "/web/quanlyidol/index.html" },
    { "source": "/quanlyidol/:match*", "destination": "/web/quanlyidol/:match*" },
    { "source": "/assets/:match*", "destination": "/web/assets/:match*" },
    { "source": "/(.*)\\.js", "destination": "/web/$1.js" },
    { "source": "/(.*)\\.html", "destination": "/web/$1.html" },
    { "source": "/", "destination": "/web/index.html" }
  ]
}
