{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/xoailac", "destination": "/xoailac/", "permanent": false },
    { "source": "/quanlau", "destination": "/quanlau/", "permanent": false },
    { "source": "/quanlyidol", "destination": "/quanlyidol/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/[...all].js" },
    { "source": "/api/(.*)", "destination": "/api/[...all].js" },
    { "source": "/admin", "destination": "/web/admin.html" },
    { "source": "/xoailac/", "destination": "/web/xoailac/index.html" },
    { "source": "/xoailac/(.*)", "destination": "/web/xoailac/$1" },
    { "source": "/quanlau/", "destination": "/web/quanlau/index.html" },
    { "source": "/quanlau/(.*)", "destination": "/web/quanlau/$1" },
    { "source": "/quanlyidol/", "destination": "/web/quanlyidol/index.html" },
    { "source": "/quanlyidol/(.*)", "destination": "/web/quanlyidol/$1" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}
